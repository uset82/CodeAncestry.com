# Copy to .env.local and fill in. .env.local is gitignored; never commit a real key.

# OpenRouter API key for the site assistant. Create one at https://openrouter.ai/keys
# The assistant routes through the "openrouter/free" Free Models Router, so a key
# with no credit still works.
#
# On Vercel: Project → Settings → Environment Variables. Set the same name on
# Production and Preview. The site builds and serves without it; only /api/chat
# fails closed.
OPENROUTER_API_KEY=
