{
  "version": 1,
  "project": "codeancestry",
  "defaultBranch": "main",
  "worktreeRoot": ".",
  "shared": {
    "owner": "cursor",
    "reason": "Claude is out of credit. Cursor is design lead and builder. One owner on shared config so the instrument does not stall.",
    "paths": [
      "package.json",
      "package-lock.json",
      "next.config.ts",
      "tsconfig.json",
      "eslint.config.mjs",
      ".github/workflows/**",
      ".gitignore",
      "agents.manifest.json"
    ]
  },
  "agents": {
    "claude": {
      "role": "paused",
      "branch": "feat/platform",
      "owns": [],
      "title": "Claude — paused (no credit)",
      "color": "orange",
      "icon": "◈",
      "worktree": "."
    },
    "cursor": {
      "role": "architect",
      "branch": "main",
      "owns": [
        "app/**",
        "components/**",
        "lib/**",
        "data/**",
        "scripts/**",
        "taskplan.md",
        "HANDOFF.md",
        "docs/**",
        "research/**"
      ],
      "title": "Cursor — design lead and builder",
      "color": "cyan",
      "icon": "▶",
      "worktree": "."
    },
    "grok": {
      "role": "builder",
      "branch": "main",
      "owns": [
        "prototypes/**"
      ],
      "title": "Grok — bounded prototypes, integrated by Cursor",
      "color": "violet",
      "icon": "◉",
      "worktree": "."
    },
    "antigravity": {
      "role": "builder",
      "branch": "main",
      "owns": [
        "public/**"
      ],
      "title": "Antigravity — assets (lane provisional, confirm with Carlos)",
      "color": "purple",
      "icon": "○",
      "worktree": "."
    },
    "kali-linux": {
      "role": "builder",
      "branch": "feat/kali-Linux",
      "owns": [
        "test/**"
      ],
      "title": "kali-Linux",
      "color": "blue",
      "icon": "🤖"
    }
  },
  "everyoneMayWrite": [
    "claims/${agent}.md",
    ".captures/**"
  ],
  "checks": {
    "verify": "npm run verify",
    "staleAfterHours": 12
  }
}
