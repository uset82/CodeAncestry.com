{
  "name": "codeancestry",
  "version": "0.1.0",
  "private": true,
  "description": "CodeAncestry — a living genealogy for software, agents and robots.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test:fixtures": "tsx scripts/validate-fixtures.ts",
    "verify": "npm run typecheck && npm run lint && npm run test:fixtures",
    "analyze": "cross-env ANALYZE=true next build"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@openrouter/agent": "^0.11.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.1.1",
    "cytoscape": "^3.34.2",
    "d3-hierarchy": "^3.1.2",
    "d3-sankey": "^0.12.3",
    "gsap": "^3.15.0",
    "mermaid": "^11.17.2",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.185.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-sankey": "^0.12.5",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/three": "^0.185.4",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.3.3",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
